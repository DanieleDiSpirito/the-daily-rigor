# Copy to .env (docker compose reads it) and to .env.local (npm run dev reads the VITE_ ones).
# Leave empty to run locally without login.
SUPABASE_URL=
SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: get a push notification (https://ntfy.sh) when someone signs in. Use a long random topic name,
# for example https://ntfy.sh/rigor-<random string>, and treat the URL as a secret. NTFY_TOKEN is only for protected topics.
NTFY_URL=
NTFY_TOKEN=
